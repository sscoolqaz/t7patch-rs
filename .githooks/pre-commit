#!/bin/sh
# Pre-commit gate: formatting and clippy must pass before a commit lands.
set -e

cargo fmt --all --check

# The crate only builds for Windows targets. On a Windows host, check the default
# target. On any host, also check mingw when its Rust target is installed.
checked=0
case "$(rustc -vV | sed -n 's/^host: //p')" in
    *windows*)
        cargo clippy --workspace --all-targets --quiet -- -D warnings
        checked=1
        ;;
esac
if rustup target list --installed 2>/dev/null | grep -q '^x86_64-pc-windows-gnu$'; then
    cargo clippy --workspace --all-targets --quiet --target x86_64-pc-windows-gnu -- -D warnings
    checked=1
fi
if [ "$checked" = 0 ]; then
    echo "pre-commit: no Windows target to check; run: rustup target add x86_64-pc-windows-gnu" >&2
    exit 1
fi
