#!/bin/sh
# Pre-commit gate: the checks in AGENTS.md must pass before a commit lands.
# fmt, clippy for both Windows targets, then the tests (natively on Windows,
# under Wine elsewhere).
set -e

cargo fmt --all --check

for target in x86_64-pc-windows-gnu x86_64-pc-windows-msvc; do
    if ! rustup target list --installed 2>/dev/null | grep -qx "$target"; then
        echo "pre-commit: target $target is missing; run: rustup target add $target" >&2
        exit 1
    fi
    cargo clippy --workspace --all-targets --quiet --target "$target" -- -D warnings
done

case "$(rustc -vV | sed -n 's/^host: //p')" in
    *windows*)
        cargo test --workspace --quiet
        ;;
    *)
        if ! command -v wine >/dev/null 2>&1; then
            echo "pre-commit: wine is needed to run the tests on a non-Windows host" >&2
            exit 1
        fi
        CARGO_TARGET_X86_64_PC_WINDOWS_GNU_RUNNER=wine \
            cargo test --workspace --quiet --target x86_64-pc-windows-gnu
        ;;
esac
